# MongoDB connection string used by the API routes.
# Populate this value with your cluster credentials when deploying.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/idle-mmo?retryWrites=true&w=majority

# Optional database name override. The app defaults to "idle-mmo" when this value is
# omitted or when the connection string does not specify a database.
MONGODB_DB=idle-mmo
